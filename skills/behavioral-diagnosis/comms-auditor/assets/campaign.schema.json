{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideas42.org/schemas/comms-auditor/campaign-1.2.json",
  "title": "Behavioral Communications Audit (campaign)",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "inventory", "audits"],
  "properties": {
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "mode", "campaign_name", "comm_count", "processing_timestamp"],
      "properties": {
        "schema_version": { "const": "1.2" },
        "mode": { "enum": ["CAMPAIGN_SCAN", "CAMPAIGN_FULL"] },
        "campaign_name": { "type": "string" },
        "comm_count": { "type": "integer", "minimum": 1 },
        "processing_timestamp": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
      }
    },
    "inventory": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["comm_id", "label", "channel", "audience_segment", "trigger_timing", "owner", "source", "status"],
        "properties": {
          "comm_id": { "type": "string", "pattern": "^C[0-9]{2,3}$" },
          "label": { "type": "string", "minLength": 1 },
          "channel": { "enum": ["email", "sms", "chat", "call_script", "web_page", "print", "push", "other"] },
          "audience_segment": { "type": "string" },
          "trigger_timing": { "type": "string" },
          "owner": { "type": "string" },
          "source": { "type": "string" },
          "status": { "enum": ["scanned", "audited", "redrafted", "queued"] }
        }
      }
    },
    "cadence_flags": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["flag", "comm_ids", "detail"],
        "properties": {
          "flag": { "enum": ["SILENT-GAP", "CLUSTER", "ORPHAN", "NO-CONFIRM", "NO-RECOVERY", "IRREGULAR-CADENCE", "UNKNOWN-TIMING"] },
          "comm_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^C[0-9]{2,3}$" } },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "consistency_register": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["conflict_id", "type", "comm_a", "quote_a", "comm_b", "quote_b", "impact", "resolution"],
        "properties": {
          "conflict_id": { "type": "string", "pattern": "^X[0-9]{1,3}$" },
          "type": { "enum": ["TERMINOLOGY", "DATE", "INSTRUCTION", "SENDER", "TONE", "CALENDAR"] },
          "comm_a": { "type": "string", "pattern": "^C[0-9]{2,3}$" },
          "quote_a": { "type": "string", "minLength": 1 },
          "comm_b": { "type": "string", "pattern": "^C[0-9]{2,3}$" },
          "quote_b": { "type": "string", "minLength": 1 },
          "impact": { "type": "string", "minLength": 1 },
          "resolution": { "type": "string", "minLength": 1 }
        }
      }
    },
    "redundancy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "duplicate_asks": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["ask", "comm_ids", "classification"],
            "properties": {
              "ask": { "type": "string" },
              "comm_ids": { "type": "array", "minItems": 2, "items": { "type": "string", "pattern": "^C[0-9]{2,3}$" } },
              "classification": { "enum": ["DUPLICATE", "REINFORCEMENT"] },
              "quote": { "type": "string" }
            }
          }
        },
        "repeated_information": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["journey_source", "stages"],
      "properties": {
        "journey_source": { "enum": ["supplied", "derived"] },
        "stages": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["stage", "comm_ids"],
            "properties": {
              "stage": { "type": "string" },
              "comm_ids": { "type": "array", "items": { "type": "string", "pattern": "^C[0-9]{2,3}$" } }
            }
          }
        },
        "uncovered_stages": { "type": "array", "items": { "type": "string" } },
        "uncovered_failure_paths": { "type": "array", "items": { "type": "string" } },
        "over_served_stages": { "type": "array", "items": { "type": "string" } }
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pattern_id", "principle", "failing_comms", "frequency", "severity"],
        "properties": {
          "pattern_id": { "type": "string", "pattern": "^PAT[0-9]{1,3}$" },
          "principle": {
            "enum": ["Salience", "Relevance & Personalization", "Credibility & Identity Alignment",
                     "Clarity, Simplicity & Brevity", "Support & Self-Efficacy", "Social",
                     "Persuasion & Cost-Benefit Value", "Clear Call-to-Action & Focus",
                     "Ease & Hassle Reduction", "Timeliness & Urgency"]
          },
          "failing_comms": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^C[0-9]{2,3}$" } },
          "frequency": { "type": "number", "minimum": 0, "maximum": 1 },
          "severity": { "enum": ["High", "Medium", "Low"] }
        }
      }
    },
    "roadmap": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "quick_wins": { "type": "array", "items": { "type": "string" } },
        "structural_fixes": { "type": "array", "items": { "type": "string" } },
        "template_proposals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "audits": {
      "type": "array", "minItems": 1,
      "description": "Full single-comm audit objects, each conforming to audit.schema.json",
      "items": { "$ref": "https://ideas42.org/schemas/comms-auditor/audit-1.2.json" }
    }
  }
}
