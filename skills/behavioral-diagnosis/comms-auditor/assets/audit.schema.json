{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideas42.org/schemas/comms-auditor/audit-1.2.json",
  "title": "Behavioral Communications Audit (single communication)",
  "description": "Ten principles across Attention, Intention, Action. Each score is 5, 3, 1, or null where the principle does not apply.",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "communication", "behavioral_scores", "stage_summary", "findings", "categorization", "analysis_summary", "assumptions", "placeholders_used"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "mode", "comm_id", "processing_timestamp"],
      "properties": {
        "schema_version": { "const": "1.2" },
        "mode": { "enum": ["AUDIT", "AUDIT_LITE", "TAG_ONLY", "REDRAFT_ONLY", "CAMPAIGN_SCAN", "CAMPAIGN_FULL"] },
        "comm_id": { "type": "string", "minLength": 1 },
        "processing_timestamp": {
          "type": ["string", "null"],
          "description": "null on emit; stamped by validate.py --stamp",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "communication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "channel", "audience_segment", "primary_goal", "source"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "channel": { "enum": ["email", "sms", "chat", "call_script", "web_page", "print", "push", "other"] },
        "audience_segment": { "type": "string" },
        "primary_goal": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "behavioral_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attention", "intention", "action"],
      "properties": {
        "attention": {
          "type": "object", "additionalProperties": false,
          "required": ["salience", "relevance_personalization", "credibility_identity_alignment"],
          "properties": {
            "salience": { "enum": [5, 3, 1, null] },
            "relevance_personalization": { "enum": [5, 3, 1, null] },
            "credibility_identity_alignment": { "enum": [5, 3, 1, null] }
          }
        },
        "intention": {
          "type": "object", "additionalProperties": false,
          "required": ["clarity_simplicity_brevity", "support_self_efficacy", "social", "persuasion_cost_benefit_value"],
          "properties": {
            "clarity_simplicity_brevity": { "enum": [5, 3, 1, null] },
            "support_self_efficacy": { "enum": [5, 3, 1, null] },
            "social": { "enum": [5, 3, 1, null] },
            "persuasion_cost_benefit_value": { "enum": [5, 3, 1, null] }
          }
        },
        "action": {
          "type": "object", "additionalProperties": false,
          "required": ["clear_cta_focus", "ease_hassle_reduction", "timeliness_urgency"],
          "properties": {
            "clear_cta_focus": { "enum": [5, 3, 1, null] },
            "ease_hassle_reduction": { "enum": [5, 3, 1, null] },
            "timeliness_urgency": { "enum": [5, 3, 1, null] }
          }
        }
      }
    },
    "stage_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attention", "intention", "action"],
      "properties": {
        "attention": { "enum": ["pass", "weak", "fail"] },
        "intention": { "enum": ["pass", "weak", "fail"] },
        "action": { "enum": ["pass", "weak", "fail"] }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["problem_id", "principle", "severity", "flagged_quote", "why", "recommended_revision"],
        "properties": {
          "problem_id": { "type": "string", "pattern": "^P[0-9]{1,2}$" },
          "principle": {
            "enum": ["Salience", "Relevance & Personalization", "Credibility & Identity Alignment",
                     "Clarity, Simplicity & Brevity", "Support & Self-Efficacy", "Social",
                     "Persuasion & Cost-Benefit Value", "Clear Call-to-Action & Focus",
                     "Ease & Hassle Reduction", "Timeliness & Urgency"]
          },
          "severity": { "enum": ["High", "Medium", "Low"] },
          "flagged_quote": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "recommended_revision": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings_omitted": { "type": "integer", "minimum": 0 },
    "categorization": {
      "type": "object", "additionalProperties": false,
      "required": ["suggested_type", "suggested_channel"],
      "properties": {
        "suggested_type": { "type": "string" },
        "suggested_channel": { "enum": ["email", "sms", "chat", "call_script", "web_page", "print", "push", "other"] }
      }
    },
    "analysis_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["key_findings", "primary_weakness"],
      "properties": {
        "key_findings": { "type": "string", "minLength": 1 },
        "primary_weakness": {
          "enum": ["salience", "relevance_personalization", "credibility_identity_alignment",
                   "clarity_simplicity_brevity", "support_self_efficacy", "social",
                   "persuasion_cost_benefit_value", "clear_cta_focus", "ease_hassle_reduction",
                   "timeliness_urgency", "none"]
        }
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "placeholders_used": { "type": "array", "items": { "type": "string", "pattern": "^\\[.+\\]$" } }
  }
}
